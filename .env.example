# ---------------------------------------------------------------------------
# Yuvomi Orchestrator — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Domain / routing ---
ROOT_DOMAIN=families.cloud
# Subdomains (under ROOT_DOMAIN) where the admin console and the
# orchestrator API are served. docker-compose.yml turns these into full
# hosts (e.g. admin.families.cloud) for Traefik and the admin UI build.
# Keep WEBAUTHN_ORIGIN / INVITE_BASE_URL below consistent with them.
ADMIN_SUBDOMAIN=admin
API_SUBDOMAIN=api
ACME_EMAIL=admin@families.cloud

# DNS-01 challenge provider for the wildcard cert (*.families.cloud).
# Traefik supports many providers; this scaffold assumes Cloudflare.
# https://doc.traefik.io/traefik/https/acme/#providers
DNS_PROVIDER=cloudflare
CF_API_EMAIL=
CF_DNS_API_TOKEN=

# --- Docker socket proxy (Tecnativa/docker-socket-proxy) ---
# Orchestrator talks to this proxy, never to /var/run/docker.sock directly.
DOCKER_SOCKET_PROXY_HOST=docker-socket-proxy
DOCKER_SOCKET_PROXY_PORT=2375

# --- Orchestrator core ---
ORCHESTRATOR_PORT=4000
ORCHESTRATOR_DB_URL=file:../data/orchestrator.db
# Generate your own with: openssl rand -hex 32
ORCHESTRATOR_SESSION_SECRET=280c50ed6e9c471d5acec0403e70a8db3b76837cc00872dff0c209c4c94e972c
ORCHESTRATOR_COOKIE_DOMAIN=families.cloud
NODE_ENV=production
# First super-admin is created automatically at first startup with this
# e-mail and a random password printed to the container logs (repeated on
# every startup until the password is changed at first login).
ADMIN_DEFAULT_EMAIL=admin@example.com

# WebAuthn / Passkeys
WEBAUTHN_RP_ID=families.cloud
WEBAUTHN_RP_NAME=Yuvomi Orchestrator
WEBAUTHN_ORIGIN=https://admin.families.cloud

# --- Tenant defaults ---
TENANT_DATA_ROOT=/srv/yuvomi/tenants
TENANT_DEFAULT_IMAGE=ghcr.io/ulsklyc/yuvomi:latest
TENANT_NETWORK=yuvomi_edge
# Port the Yuvomi Express app listens on inside its own container
TENANT_APP_PORT=3000
# Where the per-tenant secrets/env file and data dir are mounted inside
# the container. Assumes the Yuvomi image loads env vars via dotenv from
# its working directory — no source changes required.
TENANT_ENV_MOUNT_PATH=/app/.env
TENANT_DATA_MOUNT_PATH=/app/data
# Shared volume path (see docker-compose.yml) where per-tenant Traefik
# route files are written — must be the same flat directory Traefik's file
# provider watches, not a subdirectory (its live watch doesn't recurse).
TRAEFIK_DYNAMIC_TENANTS_DIR=/etc/traefik/dynamic

# --- Notifications: SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Yuvomi <no-reply@families.cloud>"

# --- Notifications: WhatsApp (whatsmeow HTTP gateway) ---
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=

# --- Invite links ---
INVITE_BASE_URL=https://admin.families.cloud/activate
INVITE_TOKEN_TTL_HOURS=48

# --- Backups ---
BACKUP_CRON=0 4 * * *
BACKUP_RETENTION_DAYS=14
# Filename of the SQLCipher database inside the tenant's data mount.
TENANT_DB_FILENAME=yuvomi.db
