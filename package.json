{
  "name": "yuvomi-orchestrator",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:orchestrator": "npm run dev --workspace packages/orchestrator",
    "dev:admin-ui": "npm run dev --workspace packages/admin-ui",
    "build": "npm run build --workspace packages/orchestrator && npm run build --workspace packages/admin-ui",
    "prisma:generate": "npm run prisma:generate --workspace packages/orchestrator",
    "prisma:migrate": "npm run prisma:migrate --workspace packages/orchestrator",
    "lint": "npm run lint --workspace packages/orchestrator && npm run lint --workspace packages/admin-ui",
    "test": "npm run test --workspace packages/orchestrator"
  }
}
